# Where the SQLite database and uploaded files live (use a persistent volume in production)
DATA_DIR=./data
# Public URL of the app (used for Stripe redirects)
APP_URL=http://localhost:3000
# Anyone who signs up with this email becomes an admin
ADMIN_EMAIL=admin@example.com
# Leave Stripe keys empty to run in demo-payments mode (no cards charged)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map tiles (optional). Defaults to OpenStreetMap; use a commercial tile provider before you get real traffic.
NEXT_PUBLIC_MAP_TILE_URL=
# Support email shown on report and legal pages
SUPPORT_EMAIL=
